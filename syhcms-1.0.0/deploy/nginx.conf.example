# Nginx 站点配置示例
#
# 使用时把 server_name 和 root 换成自己的域名与目录。
# 关键只有两点：root 指向 public/，其余请求交给 index.php。

server {
    listen 80;
    server_name example.com www.example.com;

    root /www/wwwroot/example.com/public;
    index index.php;
    charset utf-8;

    # 安装完成后建议直接删除 public/install.php；
    # 如果想保留安装文件，也可以在这里关掉访问：
    # location = /install.php { deny all; }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        # PHP-FPM 一般是 /tmp/php-cgi-版本.sock，按实际版本改
        fastcgi_pass unix:/tmp/php-cgi-82.sock;
        fastcgi_index index.php;
    }

    # 静态资源缓存
    location ~* \.(js|css|png|jpg|jpeg|gif|webp|svg|ico|woff2?)$ {
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    # 隐藏文件
    location ~ /\.(?!well-known) {
        deny all;
    }

    access_log /www/wwwlogs/example.com.log;
    error_log  /www/wwwlogs/example.com.error.log;
}
